# Application Configuration
APP_NAME="AI Medical Report Explainer"
APP_ENV=development
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration
# In development/testing, SQLite fallback can be used if PostgreSQL is not available:
# DATABASE_URL="sqlite:///./medical_explainer.db"
# Or PostgreSQL:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/medi_explainer"

# File Upload Configuration
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB
ALLOWED_MIME_TYPES=["application/pdf", "image/png", "image/jpeg"]

# AI & LLM Service Configuration
# LLM_PROVIDER options: mock, openai, anthropic, custom_http
LLM_PROVIDER="mock"
MOCK_AI_RESPONSE_DELAY=0.1
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
CUSTOM_LLM_ENDPOINT=""
CUSTOM_LLM_API_KEY=""

# RAG & Reference Documents
REFERENCE_DOCS_DIR="./data/references"
EMBEDDING_PROVIDER="mock"  # mock or tfidf or openai
VECTOR_SEARCH_TOP_K=4

# OCR Engine
# OCR_ENGINE options: auto, pymupdf, tesseract
OCR_ENGINE="auto"
TESSERACT_CMD=""

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
