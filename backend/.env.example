# Required local MySQL Community Server configuration.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=medical_report_db
DB_USER=medical_app
DB_PASSWORD=replace_with_your_local_password
DB_MIGRATION_USER=medical_migrator
DB_MIGRATION_PASSWORD=replace_with_a_separate_migration_password

# Reference only: the application constructs its URL from DB_* fields,
# safely escaping the username/password (including special characters).
DATABASE_URL=mysql+pymysql://medical_app:replace_with_your_local_password@127.0.0.1:3306/medical_report_db

APP_NAME="AI Medical Report Explainer"
APP_ENV=development
DEBUG=false
API_V1_STR="/api/v1"
SECRET_KEY=replace-this-with-a-private-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=["application/pdf", "image/png", "image/jpeg"]

LLM_PROVIDER=mock
MOCK_AI_RESPONSE_DELAY=0.05
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=180
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CUSTOM_LLM_ENDPOINT=
CUSTOM_LLM_API_KEY=

REFERENCE_DOCS_DIR=./data/references
EMBEDDING_PROVIDER=mock
RETRIEVAL_MODE=local_tfidf
VECTOR_SEARCH_TOP_K=4

OCR_ENGINE=auto
TESSERACT_CMD=
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
